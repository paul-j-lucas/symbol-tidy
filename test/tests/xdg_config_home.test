EXPECTED_EXIT=1

(
  export XDG_CONFIG_HOME="$PWD/data/xdg_config_home"

  test_symbol_tidy $TIDY_TEST_OPTIONS \
    fwd_dec.c
)

(
  export XDG_CONFIG_DIRS="/does/not/exist:$PWD/data/xdg_config_home"

  test_symbol_tidy $TIDY_TEST_OPTIONS \
    fwd_dec.c
)

(
  export XDG_CONFIG_DIRS="/does/not/exist-1:/does/not/exist-2"

  test_symbol_tidy $TIDY_TEST_OPTIONS \
    fwd_dec.c
)

